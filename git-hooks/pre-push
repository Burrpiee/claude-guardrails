#!/usr/bin/env bash
# git pre-push hook: refuses a push that would undo the default branch's
# recent work (undo-check.sh). git runs it inside `git push`, after every
# commit exists, so it sees a commit made in the same command as its push,
# which the push guard cannot; and it covers pushes from a terminal or an IDE
# too. A git hook can only refuse, not ask: a meant undo is pushed again with
# GUARDRAILS_ALLOW_UNDO=1, after asking the user (from Claude Code, the push
# guard asks too). A check that cannot run -- a failed fetch, a remote given
# as a URL no remote here has, no fetched default branch -- or that breaks
# lets the push through with a warning, so a bug cannot block every push.
#
# Each repo's own .git/hooks/pre-push is a small stub that runs this file's
# copy in the plugin's data folder (guardrails-install-git-hooks), beside
# undo-check.sh and lib.sh; the plugin's own folder moves on every update.
remote=$1; url=$2
here=$(cd "$(dirname "$0")" && pwd)
check="$here/undo-check.sh"; [ -f "$check" ] || check="$here/../scripts/undo-check.sh"
lib="$here/lib.sh"; [ -f "$lib" ] || lib="$here/../scripts/lib.sh"
. "$lib" 2>/dev/null || gr_timeout() { shift; "$@"; }
warn() { echo "guardrails: $*" >&2; }
export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never
# A push by URL names no remote; find the one with that URL, whose fetched
# branches the check compares against.
if ! git remote | grep -qxF -- "$remote"; then
  for r in $(git remote); do
    [ "$(git remote get-url --push "$r" 2>/dev/null)" = "$url" ] && { remote=$r; break; }
  done
fi
fetched=""
status=0
while read -r _ lsha rref rsha; do
  # A delete, or anything but a branch (a tag), is never the case this guards.
  case "$lsha" in *[!0]*) ;; *) continue ;; esac
  case "$rref" in refs/heads/*) ;; *) continue ;; esac
  branch=${rref#refs/heads/}
  if ! git remote | grep -qxF -- "$remote"; then
    warn "'$branch' is pushed to $url, which no remote here has, so the undo check cannot run; pushing unchecked."
    continue
  fi
  # Fresh state: a pull request merged on the server is invisible until fetched.
  if [ -z "$fetched" ]; then
    gr_timeout 8 git fetch -q "$remote" 2>/dev/null </dev/null \
      || warn "fetching $remote failed, so the undo check compares against $remote as last fetched."
    fetched=1
  fi
  case "$rsha" in *[!0]*) ;; *) rsha="" ;; esac
  reason=$(bash "$check" "$PWD" "$remote" "$lsha" "$rsha" </dev/null); st=$?
  if [ "$st" -eq 2 ]; then
    warn "the undo check could not run for '$branch' (no fetched default branch on $remote, no history in common with it, or git older than 2.37); pushing unchecked."
    continue
  elif [ "$st" -ne 0 ]; then
    warn "the undo check failed for '$branch'; pushing unchecked."
    continue
  fi
  [ -z "$reason" ] && continue
  if [ "${GUARDRAILS_ALLOW_UNDO:-}" = 1 ]; then
    warn "'$branch' allowed by GUARDRAILS_ALLOW_UNDO=1: $reason."
    continue
  fi
  warn "refused '$branch': $reason. If a revert is meant, ask the user, then push again with GUARDRAILS_ALLOW_UNDO=1."
  status=1
done
exit $status
