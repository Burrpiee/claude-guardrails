{
  "description": "guardrails: guards on shell commands and agent launches, session status, context reminder, compaction",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-status.sh", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/context-reminder.sh", "timeout": 15 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/precompact-snapshot.sh", "timeout": 15 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/precompact-handoff.sh after-handoff", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cost-guard.sh", "timeout": 15, "onFailure": "block" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/push-guard.sh", "timeout": 15, "onFailure": "block" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pkill-guard.sh", "timeout": 15, "onFailure": "block" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/claude-word-guard.sh", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/agent-launch-guard.sh", "timeout": 15, "onFailure": "block" }
        ]
      }
    ]
  }
}
